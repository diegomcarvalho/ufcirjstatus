from uptime_kuma_api import UptimeKumaApi

with UptimeKumaApi("http://localhost:3002") as api:
    api.login("carvalho", "saojose4")
    # Retrieve all monitors
    monitors = api.get_monitors()

    for monitor in monitors:
        # Skip monitor groups if you only want actual endpoints
        if monitor["type"].name == "GROUP":
            continue
        if not monitor["active"]:
            continue

        status = api.get_monitor_status(monitor["id"])
        print(f"{monitor['name']} (ID: {monitor['id']}): {status.name}")
